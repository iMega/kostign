---
import { contact } from "../lib/contact";
import { getTranslations, type Language } from "../lib/i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="contact-cta" aria-labelledby="contact-cta-title">
  <h2 class="contact-cta__title" id="contact-cta-title">{t.cta.title}</h2>
  <p class="contact-cta__text">{t.cta.text}</p>
  <a class="button contact-cta__button" href={contact.phoneHref}>{t.contact.call}</a>
</section>
