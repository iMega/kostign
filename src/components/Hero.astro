---
import { contact } from "../lib/contact";
import { getTranslations, type Language } from "../lib/i18n";
import Arrow from "./icons/Arrow.astro";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="hero" aria-labelledby="headline">
  <div class="hero__portrait">
    <div class="hero__circle"></div>
    <img
      class="hero__image"
      src="/assets/owner-640.webp"
      srcset="/assets/owner-480.webp 480w, /assets/owner-640.webp 640w, /assets/owner-960.webp 960w"
      sizes="(width <= 47.5rem) clamp(16.25rem, 74vw, 27.5rem), min(50vw, 38.75rem)"
      width="1254"
      height="1254"
      alt={t.hero.owner}
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="hero__intro">
    <h1 class="hero__title" id="headline">
      {
        t.hero.title.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))
      }
    </h1>
    <p class="hero__subtitle">{t.hero.subtitle}</p>
    <div class="hero__actions">
      <a class="button button--accent" href={contact.phoneHref} data-track="call" data-track-location="hero">{t.contact.call}</a>
      <a class="route-link" href={contact.mapUrl} target="_blank" rel="noopener" data-track="directions" data-track-location="hero">
        <span>{t.hero.directions}</span>
        <Arrow />
      </a>
    </div>
  </div>
</section>
