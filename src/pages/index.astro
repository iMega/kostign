---
import { defaultLanguage, languagePath } from "../lib/i18n";

// The server needs index.html at the root: it sends visitors to the
// default language.
const to = languagePath(defaultLanguage);
---

<!doctype html>
<html lang={defaultLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={to} />
    <title>Kostas Ignatiadis</title>
  </head>
  <body>
    <a href={to}>Kostas Ignatiadis</a>
  </body>
</html>
