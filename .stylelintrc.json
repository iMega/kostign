{
  "extends": ["stylelint-config-standard"],
  "overrides": [
    {
      "files": ["**/*.astro"],
      "customSyntax": "postcss-html"
    }
  ],
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:(?:__|--)[a-z0-9]+(?:-[a-z0-9]+)*)*$",
      {
        "message": "Expected class selector to use kebab-case or BEM syntax"
      }
    ]
  }
}
